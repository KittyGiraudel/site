# First-party by default. Third parties: Giscus, CodePen, pinned jsDelivr
# packages (Chart.js / Howler), Baseline widget, ProMe audio.
# https: on img/frame covers Iconify, link favicons, and old post iframes.
# unsafe-inline is required for inlined production JS/CSS, JSON-LD, and a few
# demos. jsDelivr is path-prefixed so the rest of npm is not executable.
/*
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Strict-Transport-Security: max-age=31536000; includeSubDomains; preload
  Permissions-Policy: geolocation=(), microphone=(), camera=(), payment=(), usb=(), fullscreen=(self)
  Content-Security-Policy: default-src 'self'; base-uri 'self'; form-action 'self'; object-src 'none'; frame-ancestors 'none'; script-src 'self' 'unsafe-inline' https://giscus.app https://codepen.io https://cpwebassets.codepen.io https://public.codepenassets.com https://cdn.jsdelivr.net/npm/chart.js@4.5.1/ https://cdn.jsdelivr.net/npm/howler@2.2.4/; style-src 'self' 'unsafe-inline' https://giscus.app https://codepen.io https://cpwebassets.codepen.io https://public.codepenassets.com; img-src 'self' data: https:; font-src 'self'; connect-src 'self' https://giscus.app https://api.github.com https://api.webstatus.dev https://prome.games; media-src 'self' data: https://prome.games; frame-src https:; worker-src 'self'; manifest-src 'self'; upgrade-insecure-requests

/
  Link: </rss/index.xml>; rel="alternate"; type="application/atom+xml", </llms.txt>; rel="describedby"; type="text/markdown", </blog/search/data.json>; rel="describedby"; type="application/json"

/assets/images/*
  cache-control: public
  cache-control: max-age=86400

/img/*
  cache-control: public
  cache-control: max-age=31536000
  cache-control: immutable

/.well-known/traffic-advice
  Content-Type: application/trafficadvice+json; charset=utf-8

/.well-known/security.txt
  Content-Type: text/plain; charset=utf-8

/llms.txt
  Content-Type: text/markdown; charset=utf-8

/*.md
  X-Robots-Tag: noindex
  Content-Type: text/markdown; charset=utf-8
